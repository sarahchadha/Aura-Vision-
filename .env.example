# ============================================================
# AuraVision Environment Configuration Template
# Copy this file to .env and insert your API credentials
# ============================================================

# Mistral AI API Key for conversational assistant
MISTRAL_API_KEY=your_mistral_api_key_here

# Hardware Streaming Endpoint (Raspberry Pi Zero W)
PI_STREAM_URL=http://172.20.10.3:8080/

# Default Host & Port
HOST=0.0.0.0
PORT=8081

# Hardware Mode Preference: 'laptop' or 'hardware'
CAMERA_PREFERENCE=laptop
MIC_PREFERENCE=auto
